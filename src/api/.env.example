CLAUDE_ENDPOINT=https://api.anthropic.com/api/oauth/usage
PORT=3000

# Interface to bind on. Default 0.0.0.0 listens on every interface. If your
# host has more than one network (e.g. laptop on Wi-Fi + cellular tether,
# a VPN, or a public IP), set this to your LAN-only IP to avoid leaking the
# endpoint onto interfaces you didn't intend to expose. Use 127.0.0.1 for a
# host-only setup (e.g. SSH tunnel).
HOST=0.0.0.0

# Cache the upstream Claude response for this many milliseconds. The firmware
# polls at most every GET_USAGE_INTERVAL_MS (default 5 min), but anyone on the
# LAN can hammer /five-hour and amplify load onto the upstream quota. The
# default 60 000 ms (1 min) caps that without making the displayed value
# meaningfully stale. Set to 0 to disable caching.
CACHE_TTL_MS=60000
